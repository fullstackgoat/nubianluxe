# ─── Database (Supabase) ────────────────────────────────────────────────────
# Get from: https://supabase.com → Project Settings → Database → Connection string
DATABASE_URL="postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres"

# ─── Supabase ───────────────────────────────────────────────────────────────
# Get from: https://supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://[ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ─── Stripe ─────────────────────────────────────────────────────────────────
# TEST keys for local dev — toggle Test mode at dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Run after switching keys: npx tsx scripts/setup-stripe-mode.ts
STRIPE_DEPOSIT_PRICE_ID=price_...
STRIPE_PREMIUM_TIER_PRICE_ID=price_...
STRIPE_VIP_TIER_PRICE_ID=price_...

STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Resend (Email) ──────────────────────────────────────────────────────────
# Get from: https://resend.com → API Keys
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="bookings@nubianluxebrand.com"

# ─── Clerk (Auth) ───────────────────────────────────────────────────────────
# Get from: https://clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# ─── Admin ──────────────────────────────────────────────────────────────────
# Set ONE of these to restrict /admin access
# CLERK_ADMIN_USER_ID: find in Clerk dashboard → Users → click your user → copy "User ID"
# ADMIN_EMAIL: the email address of the admin Clerk account
CLERK_ADMIN_USER_ID="user_..."
# ADMIN_EMAIL="owner@nubianluxebrand.com"

# ─── App ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

CLERK_ADMIN_USER_ID=user_3EUkqgnwOBMuQlojCERuP8f1uOk
ADMIN_EMAIL=taliahmason@outlook.com